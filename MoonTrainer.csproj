<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds MoonTrainer.dll with the .NET SDK (6 or newer):

        dotnet build -c Release
        dotnet build -c Release -p:GameDir="D:\SteamLibrary\steamapps\common\Moon Sweepers"

    The game needs MSML installed and to have been started once, so that BepInEx\interop exists.
    The DLL lands in bin\. Copy it and Mods\MoonTrainer\mod.json into <game>\Mods\MoonTrainer\ to try it.

    Note: the releases so far were compiled with the Roslyn compiler directly, against the same references listed
    here. This project file has not been run through "dotnet build" yet, so treat the first run as a test.
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Moon Sweepers</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>

    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MoonTrainer</AssemblyName>
    <RootNamespace>MoonTrainer</RootNamespace>
    <Version>1.3.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\*.cs" />
  </ItemGroup>

  <!-- BepInEx, Il2CppInterop and the interop assemblies MSML generates from the game. They come from the local
       game install and are never copied next to the mod. -->
  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\*.dll" Exclude="$(BepInExDir)\interop\netstandard.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckGameSetup" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(BepInExDir)\interop\Assembly-CSharp.dll')"
           Text="Interop assemblies not found in '$(BepInExDir)\interop'. Install MSML, start the game once, or pass -p:GameDir=&quot;...&quot;." />
  </Target>
</Project>
